    "%lld work blocks combined: the start is your first start, the break contains all interruptions, and the end follows from start, working time and break.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Arbeitsblock zusammengefasst: Beginn ist dein erster Start, die Pause enthält alle Unterbrechungen, das Ende ergibt sich aus Beginn, Arbeitszeit und Pause."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Arbeitsblöcke zusammengefasst: Beginn ist dein erster Start, die Pause enthält alle Unterbrechungen, das Ende ergibt sich aus Beginn, Arbeitszeit und Pause."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld work block combined: the start is your first start, the break contains all interruptions, and the end follows from start, working time and break."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld work blocks combined: the start is your first start, the break contains all interruptions, and the end follows from start, working time and break."
                }
              }
            }
          }
        }
      }
    },
    "%lld work blocks of all jobs will be removed permanently. The jobs and their rules are kept. This cannot be undone.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Arbeitsblock aller Jobs wird dauerhaft entfernt. Die Jobs und ihre Regeln bleiben erhalten. Das kann nicht rückgängig gemacht werden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Alle %lld Arbeitsblöcke aller Jobs werden dauerhaft entfernt. Die Jobs und ihre Regeln bleiben erhalten. Das kann nicht rückgängig gemacht werden."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld work block of all jobs will be removed permanently. The jobs and their rules are kept. This cannot be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld work blocks of all jobs will be removed permanently. The jobs and their rules are kept. This cannot be undone."
                }
              }
            }
          }
        }
      }
    },
